// Extract all company URLs from the directory page
const company_links = $('._company_18olp_357');

const company_urls = company_links.toArray().map(link => {
    const href = $(link).attr('href');
    if (href) {
        // Convert relative URL to absolute URL
        return new URL(href, 'https://www.ycombinator.com').href;
    }
    return null;
}).filter(Boolean);

console.log(Extracted ${company_urls.length} company URLs);

return {
    company_urls
};
